# ==============================================================================
# DevLab AI Studio Web Console Environment Template (apps/web/.env.example)
# Copy this file to `apps/web/.env.local` for local development.
# ==============================================================================

# ─── Server Port ─────────────────────────────────────────────────────────────
# Local Next.js web application HTTP port (dev: 3002, prod: 3012)
PORT=3002

# ─── API & Backend Endpoints ─────────────────────────────────────────────────
# Base HTTP URL for the Studio NestJS API (apps/api).
NEXT_PUBLIC_STUDIO_API_URL=http://localhost:4002

# Base HTTP URL for the Studio AI Gateway (apps/gateway).
NEXT_PUBLIC_STUDIO_GATEWAY_URL=http://localhost:8002

# ─── DevLab Portal & Authentication ──────────────────────────────────────────
# Portal Web UI URL (for login redirects)
NEXT_PUBLIC_DEVLAB_PORTAL_WEB_URL=http://localhost:3000

# Portal API URL (for token verification / OIDC)
NEXT_PUBLIC_DEVLAB_PORTAL_API_URL=http://localhost:4000
