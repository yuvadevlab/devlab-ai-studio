# ==============================================================================
# DevLab AI Studio Gateway Environment Template (apps/gateway/.env.example)
# Copy this file to `apps/gateway/.env.local` for local development.
# ==============================================================================

# ─── Server Port ─────────────────────────────────────────────────────────────
PORT=8002

# ─── Upstream API ────────────────────────────────────────────────────────────
STUDIO_API_URL=http://localhost:4002

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (web console + fin-ai)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# ─── Upstash Redis (optional — in-memory fallback used if unset) ─────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Telemetry ───────────────────────────────────────────────────────────────
TELEMETRY_STREAM_KEY=devlab:ai:telemetry
PROFILE_CACHE_TTL_MS=30000

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_ENABLED=true
LOG_LEVEL=info
